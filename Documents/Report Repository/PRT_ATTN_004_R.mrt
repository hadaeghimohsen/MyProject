    <DataSources isList="true" count="2">
      <MQL Ref="3" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>MQL</Alias>
        <Columns isList="true" count="3">
          <value>NAME_DNRM,System.String</value>
          <value>MTOD_DESC,System.String</value>
          <value>ATTN_CONT,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>MQL</Name>
        <NameInSource>iScsc</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT C.NAME_DNRM, M.MTOD_DESC, COUNT(A.CODE) AS ATTN_CONT 
	FROM ATTENDANCE A, FIGHTER C, METHOD M, dbo.V#Report_Action_Parameter Ra
 WHERE A.COCH_FILE_NO = C.FILE_NO 
   AND A.MTOD_CODE_DNRM = M.CODE
   AND A.ATTN_DATE BETWEEN Ra.FROM_DATE AND Ra.TO_DATE 
   AND (ra.COCH_FILE_NO IS NULL OR a.COCH_FILE_NO = ra.COCH_FILE_NO)
   AND (ra.CBMT_CODE IS NULL OR a.CBMT_CODE_DNRM = ra.CBMT_CODE)
 GROUP BY C.NAME_DNRM, M.MTOD_DESC;</SqlCommand>
      </MQL>
      <V_x0023_Report_Action_Parameter Ref="4" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>V#Report_Action_Parameter</Alias>
        <Columns isList="true" count="20">
