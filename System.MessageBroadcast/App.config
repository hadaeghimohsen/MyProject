    <system.serviceModel>
        <bindings />
        <client />
    </system.serviceModel>
    <appSettings>
        <add key="LidomaApiBaseUrl" value="https://api.lidomamarket.ir" />
        <add key="LidomaLoggingEnabled" value="true" />
        <add key="LidomaCacheDurationMinutes" value="5" />
