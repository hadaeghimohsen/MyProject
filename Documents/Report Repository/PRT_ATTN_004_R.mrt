          <value>MDFY_DATE,System.DateTime</value>
          <value>PRES_FROM_DATE,System.String</value>
          <value>PRES_TO_DATE,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>V#Report_Action_Parameter</Name>
        <NameInSource>iScsc</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>select *,
	dbo.Get_Mtos_U(FROM_DATE) AS PRES_FROM_DATE,	
	dbo.Get_Mtos_U(TO_DATE) AS PRES_TO_DATE
from V#Report_Action_Parameter</SqlCommand>
      </V_x0023_Report_Action_Parameter>
